<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application>
        <meta-data
            android:name="org.godotengine.plugin.v2.NeonAds"
            android:value="com.vedshubham.neonads.NeonAds" />
        <receiver
            android:name="com.vedshubham.neonads.ReminderReceiver"
            android:exported="false" />
        <!-- lets the share sheet read the score card picture the game saves -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.neonshare"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/neon_share_paths" />
        </provider>
    </application>
</manifest>
