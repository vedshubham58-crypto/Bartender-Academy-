; Engine configuration file.
config_version=5

[application]

config/name="Bartender: The Cocktail Academy"
config/description="Work behind a real bar and learn cocktails you can make for real."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

Save="*res://scripts/save.gd"
Recipes="*res://scripts/recipes.gd"
Audio="*res://scripts/audio.gd"
Ads="*res://scripts/ads.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/handheld/orientation=0

[editor_plugins]

enabled=PackedStringArray("res://addons/neon_ads/plugin.cfg")

[gui]

theme/custom_font="res://fonts/ui.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true
sensors/enable_accelerometer=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
scaling_3d/scale=0.85
